/// <reference path=".config/sa.d.ts" />

// ════════════════════════════════════════════════════════════════
//  CONFIG
// ════════════════════════════════════════════════════════════════
const CFG = {
  TIME_LIMIT_MS:   90000,
  RECORD_EVERY_MS: 150,
  MAX_WAYPOINTS:   600,
  ARRIVAL_RADIUS:  6.0,

  SPAWNS: [],
  CHECKPOINTS: [],

  // All car models from the provided list
  CAR_MODELS: [
    602, 496, 401, 518, 527, 589, 419, 587, 533, 526,
    474, 545, 517, 410, 600, 436, 439, 549, 491,
    445, 604, 507, 585, 466, 492, 546, 551, 516, 467,
    426, 547, 405, 580, 409, 550, 566, 540, 421, 529,
  ],

  GHOST_COLORS: [
    [76, 0],
    [79, 0],
    [92, 0],
    [55, 0],
    [41, 0],
  ],
};

// ════════════════════════════════════════════════════════════════
//  GLOBAL STATE
//  All active objects are tracked here so F5 always wipes them
//  before starting a new run, preventing stacking.
// ════════════════════════════════════════════════════════════════

let activePlayerCar = null;
let activeCpBlip       = null;
let activeCpMarker     = null;
let activeGhosts    = [];
let stopRequested   = false;

// ════════════════════════════════════════════════════════════════
//  HELPERS
// ════════════════════════════════════════════════════════════════

function dist2(x1, y1, x2, y2) {
  const dx = x1 - x2, dy = y1 - y2;
  return Math.sqrt(dx * dx + dy * dy);
}

function loadModelSync(id) {
  Streaming.RequestModel(id);
  Streaming.LoadAllModelsNow();
  return Streaming.HasModelLoaded(id);
}

function spawnCarSync(modelId, x, y, z) {
  if (!loadModelSync(modelId)) return null;
  const car = Car.Create(modelId, x, y, z);
  Streaming.MarkModelAsNoLongerNeeded(modelId);
  return car || null;
}

// Cast downward from 200 units up to always hit the real surface
function getGroundZ(x, y) {
  return World.GetGroundZFor3DCoord(x, y, 200.0);
}

// Returns {x, y, z} snapped to ground, avoiding water.
// If the ground is underwater, snaps to the nearest road node instead.
function getSafeCheckpoint(x, y) {
  const gz = getGroundZ(x, y);
  const wh = World.GetWaterHeightAtCoords(x, y, false);
  // wh > gz means the surface is submerged
  if (wh > gz) {
    const node = Path.GetClosestCarNode(x, y, gz);
    const nz   = getGroundZ(node.nodeX, node.nodeY);
    return { x: node.nodeX, y: node.nodeY, z: nz + 1.0 };
  }
  return { x, y, z: gz + 1.0 };
}

// ════════════════════════════════════════════════════════════════
//  GLOBAL CLEANUP
//  Destroys every tracked object. Called on F5 and after each round.
// ════════════════════════════════════════════════════════════════

function globalCleanup(ejectPlayer) {
  for (const g of activeGhosts) {
    if (g.blip)    g.blip.remove();
    if (g.wpBlips) for (const b of g.wpBlips) b.remove();
    if (g.driver)  g.driver.delete();
    if (g.car)     g.car.delete();
  }
  activeGhosts = [];

  if (activeCpBlip)   { activeCpBlip.remove();   activeCpBlip   = null; }
  if (activeCpMarker) { activeCpMarker.delete(); activeCpMarker = null; }

  for (const b of allCreatorBlips) b.remove();
  allCreatorBlips = [];

  if (activePlayerCar) {
    if (ejectPlayer) {
      const char = new Player(0).getChar();
      if (char.isInAnyCar()) {
        const pos = char.getCoordinates();
        char.warpFromCarToCoord(pos.x, pos.y, pos.z);
        wait(0);
      }
    }
    activePlayerCar.delete();
    activePlayerCar = null;
  }
}

// Clean up ghosts/blips between rounds WITHOUT touching the player car
function roundCleanup() {
  for (const g of activeGhosts) {
    if (g.blip)    g.blip.remove();
    if (g.wpBlips) for (const b of g.wpBlips) b.remove();
    if (g.driver)  g.driver.delete();
    if (g.car)     g.car.delete();
  }
  activeGhosts = [];
  if (activeCpBlip)   { activeCpBlip.remove();   activeCpBlip   = null; }
  if (activeCpMarker) { activeCpMarker.delete(); activeCpMarker = null; }
}

// ════════════════════════════════════════════════════════════════
//  SPAWN GHOSTS  (appends to activeGhosts)
// ════════════════════════════════════════════════════════════════

function buildRoadPath(waypoints) {
  // Snap each waypoint to nearest road node, deduplicate adjacent duplicates
  const path = [];
  for (const wp of waypoints) {
    const n = Path.GetClosestCarNodeWithHeading(wp.x, wp.y, wp.z);
    const last = path[path.length - 1];
    // Skip if same node as previous (dedup)
    if (last && Math.abs(n.nodeX - last.x) < 0.5 && Math.abs(n.nodeY - last.y) < 0.5) continue;
    path.push({ x: n.nodeX, y: n.nodeY, z: n.nodeZ });
  }
  return path;
}

function spawnGhosts(recordings) {
  for (let i = 0; i < recordings.length; i++) {
    const entry = recordings[i];
    const rawRec = entry.waypoints;
    if (!rawRec || rawRec.length < 2) continue;

    // Build road-snapped path
    const rec = buildRoadPath(rawRec);
    if (rec.length < 2) continue;

    const start = rec[0];
    const ghostModel = entry.carModel || CFG.CAR_MODELS[0];
    const car   = spawnCarSync(ghostModel, start.x, start.y, start.z);
    if (!car) continue;

    car.setProofs(true, true, true, false, false);
    car.changeColor(CFG.GHOST_COLORS[i % CFG.GHOST_COLORS.length][0],
                    CFG.GHOST_COLORS[i % CFG.GHOST_COLORS.length][1]);

    const driver = Char.CreateRandomAsDriver(car);
    if (!driver) { car.delete(); continue; }
    wait(0);

    // Issue first waypoint
    Task.CarDriveToCoord(driver, car, rec[1].x, rec[1].y, rec[1].z, 30.0, 0, 0, 6);

    const blip = Blip.AddForCar(car);
    blip.changeColor(1);
    blip.changeScale(1);

    activeGhosts.push({ car, driver, blip, rec, wpBlips: [], wpIdx: 1 });
  }
}

// ════════════════════════════════════════════════════════════════
//  SINGLE ROUND
// ════════════════════════════════════════════════════════════════

function runRound(round, totalRounds, recordings, prevCar) {
  const cp       = CFG.CHECKPOINTS[round];
  const spawnCfg = CFG.SPAWNS[round];
  const carModel = CFG.CAR_MODELS[Math.floor(Math.random() * CFG.CAR_MODELS.length)];
  const player   = new Player(0);
  const char     = player.getChar();

  // Snap checkpoint to nearest road node
  const cpNode = Path.GetClosestCarNodeWithHeading(cp.x, cp.y, cp.z);
  const cpX = cpNode.nodeX, cpY = cpNode.nodeY, cpZ = cpNode.nodeZ;

  // Snap spawn to nearest road node
  const spNode = Path.GetClosestCarNodeWithHeading(spawnCfg.x, spawnCfg.y, spawnCfg.z);
  const spX = spNode.nodeX, spY = spNode.nodeY, spZ = spNode.nodeZ;

  // Spawn new car at spawn point
  activePlayerCar = spawnCarSync(carModel, spX, spY, spZ);
  if (!activePlayerCar) return { type: "DEAD", recording: [], roundTime: 0 };
  activePlayerCar.setHeading(spawnCfg.heading !== undefined ? spawnCfg.heading : spNode.angle);

  // Delete old car first so camera detaches, then eject on foot, then warp into new car
  if (prevCar) {
    if (char.isInCar(prevCar)) {
      char.warpFromCarToCoord(spX, spY, spZ);
      wait(0);
    }
    prevCar.delete();
    wait(0);
  } else if (char.isInAnyCar()) {
    char.warpFromCarToCoord(spX, spY, spZ);
    wait(0);
  }
  char.warpIntoCar(activePlayerCar);

  player.clearWantedLevel();

  activeCpBlip = Blip.AddForCoord(cpX, cpY, cpZ);
  activeCpBlip.changeColor(2);
  activeCpBlip.changeScale(2);

  activeCpMarker = Checkpoint.Create(1, cpX, cpY, cpZ, cpX, cpY, cpZ, 6.0);

  spawnGhosts(recordings);

  if (round === 0) {
    showTextBox("~y~Round 1/" + totalRounds + "~n~~w~Reach: " + cp.name);
  } else {
    showTextBox("~y~Round " + (round + 1) + "/" + totalRounds + " | " + activeGhosts.length + " ghost(s)~n~~w~Reach: " + cp.name);
  }
  wait(1500);
  showTextBox("~g~GO!");
  wait(200);

  const thisRec  = [];
  const startPos = activePlayerCar.getCoordinates();
  thisRec.push({ x: startPos.x, y: startPos.y, z: startPos.z });
  let recTimer   = 0;
  let lastTick   = 0;
  TIMERA = 0;

  let f6d = false;
  let result = null;

  while (!result) {
    wait(0);

    const f6n = Pad.IsKeyPressed(VK_F6);
    if (f6n && !f6d) { result = "STOP"; break; }
    f6d = f6n;

    const now = TIMERA;
    const dt  = now - lastTick;
    lastTick  = now;
    recTimer  += dt;

    const timeLeft = CFG.TIME_LIMIT_MS - now;
    if (timeLeft <= 10000) {
      showTextBox("~r~TIME: " + Math.ceil(timeLeft / 1000) + "s");
    }
    if (timeLeft <= 0)                             { result = "TIMEOUT"; break; }
    if (player.isDead() || char.hasBeenArrested()) { result = "DEAD";    break; }

    if (recTimer >= CFG.RECORD_EVERY_MS && thisRec.length < CFG.MAX_WAYPOINTS) {
      recTimer = 0;
      const p = activePlayerCar.getCoordinates();
      thisRec.push({ x: p.x, y: p.y, z: p.z });
    }

    for (const g of activeGhosts) {
      if (!g.car || !g.driver || !g.rec) continue;

      const gp = g.car.getCoordinates();
      const wp = g.rec[g.wpIdx];
      if (dist2(gp.x, gp.y, wp.x, wp.y) < 8.0) {
        g.wpIdx = (g.wpIdx + 1) % g.rec.length;
        if (g.wpIdx === 0) g.car.setCoordinates(g.rec[0].x, g.rec[0].y, g.rec[0].z);
        const next = g.rec[g.wpIdx];
        Task.CarDriveToCoord(g.driver, g.car, next.x, next.y, next.z, 30.0, 0, 0, 6);
      }
    }

    const pp = char.getCoordinates();
    if (dist2(pp.x, pp.y, cpX, cpY) < CFG.ARRIVAL_RADIUS) {
      if (activePlayerCar) activePlayerCar.freezePosition(true);
      result = "WIN_ROUND";
      break;
    }
  }

  // Clean ghosts/blips but keep player car alive for next round transition
  roundCleanup();
  return { type: result, recording: thisRec, cpX, cpY, cpZ, carModel, car: activePlayerCar, roundTime: TIMERA };
}

// ════════════════════════════════════════════════════════════════
//  FULL GAME
// ════════════════════════════════════════════════════════════════

function formatTime(ms) {
  const totalSec = Math.floor(ms / 1000);
  const m = Math.floor(totalSec / 60);
  const s = totalSec % 60;
  return m + "m " + String(s).padStart(2, "0") + "s";
}

function endGame(reason, round, totalRounds, elapsedMs) {
  // Eject player safely before deleting car
  const char = new Player(0).getChar();
  if (char.isInAnyCar()) {
    const pos = char.getCoordinates();
    char.warpFromCarToCoord(pos.x, pos.y, pos.z);
    wait(0);
  }
  globalCleanup(false);
  World.SetCarDensityMultiplier(1.0);
  World.SetPedDensityMultiplier(1.0);

  const timeStr = formatTime(elapsedMs);
  if (reason === "WIN") {
    showTextBox("~g~YOU WIN!~n~~w~Time: " + timeStr);
  } else if (reason === "TIMEOUT") {
    showTextBox("~r~TIME'S UP!~n~~w~Rounds: " + round + "/" + totalRounds + "  Time: " + timeStr);
  } else if (reason === "STOP") {
    showTextBox("~w~Stopped.~n~Rounds: " + round + "/" + totalRounds + "  Time: " + timeStr);
  } else {
    showTextBox("~r~GAME OVER~n~~w~Rounds: " + round + "/" + totalRounds + "  Time: " + timeStr);
  }
  wait(4000);
}

function runGame() {
  globalCleanup(false);
  stopRequested = false;

  World.SetCarDensityMultiplier(0.0);
  World.SetPedDensityMultiplier(0.0);

  const totalRounds = Math.min(CFG.SPAWNS.length, CFG.CHECKPOINTS.length);
  let round         = 0;
  let recordings    = [];
  let prevCar       = null;
  let elapsedMs     = 0;

  while (round < totalRounds) {
    const result = runRound(round, totalRounds, recordings, prevCar);
    elapsedMs += result.roundTime || 0;

    if (result.type === "WIN_ROUND") {
      recordings.push({ waypoints: result.recording, cpX: result.cpX, cpY: result.cpY, cpZ: result.cpZ, carModel: result.carModel });
      prevCar = result.car;

      if (round + 1 >= totalRounds) {
        endGame("WIN", totalRounds, totalRounds, elapsedMs);
        return;
      }

      showTextBox("~g~CHECKPOINT! " + (round + 1) + "/" + totalRounds);
      wait(800);
      round++;

    } else if (result.type === "TIMEOUT") {
      endGame("TIMEOUT", round, totalRounds, elapsedMs);
      return;

    } else if (result.type === "STOP") {
      endGame("STOP", round, totalRounds, elapsedMs);
      return;

    } else {
      endGame("DEAD", round, totalRounds, elapsedMs);
      return;
    }
  }

  World.SetCarDensityMultiplier(1.0);
  World.SetPedDensityMultiplier(1.0);
}


